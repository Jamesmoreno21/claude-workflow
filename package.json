{
  "name": "claude-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "A /workflow skill for Claude Code with a local cockpit UI: validate, plan, code, review and publish a task with voice.",
  "license": "MIT",
  "author": "Jamesmoreno21",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jamesmoreno21/claude-workflow.git"
  },
  "homepage": "https://github.com/Jamesmoreno21/claude-workflow#readme",
  "bugs": {
    "url": "https://github.com/Jamesmoreno21/claude-workflow/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w web && npm run build -w server",
    "dev:web": "npm run dev -w web",
    "demo": "npm run build && node server/bin/demo.js",
    "install-skill": "bash scripts/install.sh",
    "test": "npm run test -w server && npm run test -w web",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "demo:dev": "npm run build -w server && WORKFLOW_DEV_ORIGIN=http://localhost:5173 node server/bin/demo.js --no-open",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@playwright/test": "~1.64.1",
    "eslint": "~9.39.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~17.14.0",
    "prettier": "~3.9.10",
    "typescript-eslint": "~8.72.1"
  }
}
